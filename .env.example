# LLM API Key (used in services/llm_client.py)
LLM_API_KEY=

# LLM model name (optional, has a default in code)
LLM_MODEL=openai/gpt-oss-20b

# ChromaDB persistence directory (optional, has a default in code)
CHROMA_PERSIST_DIR=data/chroma_db

# Embedding model name (optional, has a default in code)
EMBEDDING_MODEL=all-MiniLM-L6-v2